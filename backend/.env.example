# Copy to backend/.env and fill in real values. Never commit backend/.env.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string


# Optional: AI-image detection model (https://sightengine.com, free tier available).
# Without these, images are judged on metadata only, and AI images whose metadata
# was stripped can only be reported as "unverified". When set, uploaded images are
# sent to Sightengine for analysis.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
