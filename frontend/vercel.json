{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/scanner", "destination": "/workbench", "permanent": true },
    { "source": "/urlcheck", "destination": "/url-check", "permanent": true },
    { "source": "/profile", "destination": "/vault", "permanent": true },
    { "source": "/auth", "destination": "/sign-in", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
